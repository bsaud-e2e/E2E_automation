SIGNUP_BASE_URL=https://azdopl-rc-registrationapp.e2language.com
STUDENT_APP_BASE_URL=https://azdopl-rc-main.e2language.com
LOGIN_URL=https://azdopl-rc-adminapp.e2language.com/Account/Login

# --- Credentials -------------------------------------------------------
# Copy this file to .env and fill these in (.env is gitignored - never
# commit real credentials). Every value below has a fallback in
# test-data/registrationData.ts, so the suite still runs if you leave one
# blank, but keep this file as the source of truth going forward rather
# than editing values in source.
#
# Split into two kinds of data:
#   1. REUSED - pre-existing staging accounts shared across specs. Each
#      one's own test(s) mutate its state (a package tier, a one-time
#      survey, an expiry date), so these need periodic refreshing - see
#      the per-variable notes below for which TC ID(s) depend on which
#      account and what "exhausted" looks like for it.
#   2. GENERATED PER RUN - not a fixed account at all. Every other test
#      registers its own fresh, uniquely-emailed account on every run
#      (utils/testUser.ts registerFreeStudent()/createOnboardedStudent()),
#      using DEFAULT_STUDENT_PASSWORD as the password template. Nothing
#      to refresh here - a new email is generated every time.

# === 1. REUSED fixture accounts (shared, pre-existing, state mutates) ===

# TC-STU-047 (Power -> Silver upgrade allowed). Also logged into by
# TC-STU-036, 060/061, 064, 070/071, 081/091/092/093, TC-E2E-053 - those
# are all read-only or hit a confirmed-broken entry point, so they don't
# mutate this account's state; only TC-STU-064 (marks a recorded class
# "Watched") does, and it can eventually run out of unwatched classes.
#
# FALLBACK POOL: TC-STU-064 tries every FIXTURE_POWER_TIER_EMAIL[_N] /
# FIXTURE_POWER_TIER_PASSWORD[_N] pair below in order and uses the first
# one that still has an unwatched class, rather than failing the moment
# the primary account runs dry. None of the _2/_3/... pairs are required -
# add one whenever the current pool is exhausted (test-data/
# registrationData.ts's accountPool() stops at the first missing number,
# so there's no fixed limit). Every other test using powerTier just reads
# FIXTURE_ACCOUNTS.powerTier directly, i.e. always the first pair below.
FIXTURE_POWER_TIER_EMAIL=
FIXTURE_POWER_TIER_PASSWORD=
# FIXTURE_POWER_TIER_EMAIL_2=
# FIXTURE_POWER_TIER_PASSWORD_2=

# TC-STU-049 (Showtime -> Gold upgrade allowed). Read-only - safe to reuse indefinitely.
FIXTURE_SHOWTIME_TIER_EMAIL=
FIXTURE_SHOWTIME_TIER_PASSWORD=

# TC-STU-052 (Express Extra -> Silver upgrade allowed). Read-only - safe to reuse indefinitely.
FIXTURE_EXPRESS_EXTRA_TIER_EMAIL=
FIXTURE_EXPRESS_EXTRA_TIER_PASSWORD=

# TC-STU-017 / TC-STU-018 (expired-free-trial "Extend Trial" survey).
# One-time-per-account: once either test completes the survey, the
# expired-trial modal stops appearing for this account at all (confirmed
# live). Needs a fresh expired FREE-tier account once spent - a PAID
# expired account (e.g. an Express/Silver/Gold tier past its access
# period) will NOT show this modal; confirmed live trying one by mistake.
FIXTURE_EXPIRED_FREE_TRIAL_EMAIL=
FIXTURE_EXPIRED_FREE_TRIAL_PASSWORD=

# TC-STU-020 (paid package extension). Self-consuming in a different way:
# the test makes a REAL 1-week extension purchase, so a passing run always
# pushes this account's expiry ~1 week out - it naturally goes back to
# "expired" and testable again once that time elapses, no swap needed
# unless you want it passing sooner than that.
FIXTURE_PAID_FOR_EXTENSION_EMAIL=
FIXTURE_PAID_FOR_EXTENSION_PASSWORD=

# TC-E2E-054 (view teacher's graded feedback). Read-only - safe to reuse
# indefinitely. Has a confirmed teacher-graded Write Email submission
# reached via test-data/registrationData.ts's GRADED_SUBMISSION_URL,
# since the Assessments grid's own click path hits the same broken
# accordion-population defect as TC-E2E-053.
FIXTURE_GRADED_SUBMISSION_EMAIL=
FIXTURE_GRADED_SUBMISSION_PASSWORD=

# === 2. GENERATED PER RUN (not a fixed account - see note above) ===

# Password used for every account this suite registers itself
# (registerFreeStudent / createOnboardedStudent / paid registration) -
# covers the large majority of TC IDs not listed above.
DEFAULT_STUDENT_PASSWORD=

# Only needed to run scripts/qa-report.js locally (CI supplies this via the
# DEEPSEEK_API_KEY repo secret instead - see .github/workflows/e2e-tests.yml).
DEEPSEEK_API_KEY=
